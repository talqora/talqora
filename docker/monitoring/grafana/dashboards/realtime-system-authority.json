    {
      "id": 11,
      "type": "stat",
      "title": "定向下行占比:direct/(direct+fallback)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "稳态应 ≈100%;<100% 需查 fallback 根因(流建立窗口/副本失联/presence 无记录)。",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 4, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 }] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["last"], "fields": "" },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "(sum(server_downlink_direct_total) or vector(0)) / ((sum(server_downlink_direct_total) + sum(server_downlink_fallback_total)) or vector(1))", "legendFormat": "direct 占比", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "双通道累计:direct / fallback 帧数",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "累计口径(direct 总数与 fallback 总数),分布式演练记录 direct/fallback 比例用。",
