{
  "id": null,
  "uid": "realtime-system-authority",
  "title": "Realtime: 系统权威监测",
  "description": "全 Go 体系(gateway → gRPC 双向流 → biz ×N → PG 分区表/Redis)实时监测权威面板,覆盖连接面/上行链路/消息处理/下行双通道(定向直发 vs pub/sub 回退)/保护面/通话面/HTTP 面/DB 面/Go 运行时/副本面。指标全集以 biz/internal/metrics/metrics.go 与 gateway/internal/metrics/metrics.go 实测为准;server job=业务层副本1(曾指 Node,现 Go 化),biz2 job=业务层副本2。",
  "tags": ["our-chat", "realtime", "authority", "go"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 101,
      "type": "row",
      "title": "连接面",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "网关活跃连接数:gateway_connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "连接实体在 gateway(WS)。接近 GATEWAY_MAX_CONNS(默认 50000)即需扩网关副本。",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "gateway_connections", "legendFormat": "gateway 活跃连接", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "biz gRPC 流数 + 在线用户:server_ws_connections / server_online_users",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "server_ws_connections 口径=本副本当前 gRPC edge 流数(每后端默认 4 流/副本);server_online_users 业务层无本地连接注册表恒 0(占位)。",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(server_ws_connections) by (job)", "legendFormat": "biz gRPC 流数({{job}})", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(server_online_users) by (job)", "legendFormat": "在线用户({{job}})", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "握手速率(按结果):rate(gateway_handshakes_total[1m])",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "unauthorized 激增=被刷或密钥不一致;over_quota=达连接配额。",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(gateway_handshakes_total[1m])) by (result)", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "慢消费者逐出:rate(gateway_evicted_total[1m])",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "发送缓冲打满即逐出——这条上扬=有客户端读得太慢(背压生效),归因时单列,勿混入消息失败。",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(gateway_evicted_total[1m])", "legendFormat": "逐出速率", "refId": "A" }
      ]
    },
    {
      "id": 201,
      "type": "row",
      "title": "上行链路",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "上行帧速率(按结果):rate(gateway_uplink_total[1m])",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "ok / bad_request / upstream_error。upstream_error 占比突增=上行流不可用(流建立窗口/biz 重启)。",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(gateway_uplink_total{result=~\".+\"}[1m])) by (result)", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "上行端到端延迟 p50/p95/p99:gateway_uplink_duration_seconds",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "网关收帧 → biz 落库返回 ack 的端到端耗时。p99 是消息可靠性关键 SLI。",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum(rate(gateway_uplink_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(gateway_uplink_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum(rate(gateway_uplink_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 301,
      "type": "row",
      "title": "消息处理",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "消息收发速率:server_message_in_total / out{result=ok}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "in=收到 message.send 帧(不论成败);out{ok}=处理成功。in 与 out{ok} 差值含限流拒绝/参数错误/系统错误。",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(server_message_in_total[1m])) by (job)", "legendFormat": "收帧({{job}})", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(server_message_out_total{result=\"ok\"}[1m])) by (job)", "legendFormat": "处理成功({{job}})", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "消息处理延迟 p50/p95/p99:server_message_duration_seconds",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "message.send 从收到帧到 ack/error 的处理耗时(biz 侧,含限流/成员查询/落库/扇出)。",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum(rate(server_message_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(server_message_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum(rate(server_message_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 401,
      "type": "row",
      "title": "下行双通道(定向直发 vs pub/sub 回退)",
