        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(gateway_downlink_total{result=~\"delivered|dropped|evicted\"}[1m])) by (result)", "legendFormat": "{{result}}", "refId": "A" }
