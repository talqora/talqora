      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "主通道=biz 按 presence.replica 经 gRPC 下行流定向直发;兜底=Redis gw:downlink pub/sub(副本未知/离线/发送失败)。fallback 陡增=定向下行异常(副本失联/流未建立)。",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(server_downlink_direct_total[1m])) by (job)", "legendFormat": "定向直发({{job}})", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(server_downlink_fallback_total[1m])) by (job)", "legendFormat": "pub/sub 回退({{job}})", "refId": "B" }
      ]
    },
